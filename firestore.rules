rules_version = '2';

// Neuroup Firestore güvenlik kuralları.
//
// Rol tabanlı yetkilendirme `users/{uid}.role` alanına dayanır (Firebase
// Auth custom claims KULLANMIYORUZ — basitlik için). `isStaff()` her
// kontrolde bir ekstra `get()` okuması gerektirir; Firestore bunu ücretsiz
// kotaya dahil sayar ama yüksek trafikte maliyetli olabileceği bilinsin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // moderatör veya admin mi? — users/{uid} dokümanından okur.
    function isStaff() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admin tarafından askıya alınmış mı? Client, banlı bir hesabı
    // authStateChanges'te tespit edip anında çıkış yaptırıyor (bkz.
    // AuthRepositoryImpl._mapWithRole); bu kontrol savunmada ikinci
    // katman — eski bir ID token hâlâ geçerliyken bile yazma
    // işlemlerini engeller.
    function isBanned() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == true;
    }

    // --- users/{userId} ---
    // Rol bilgisi burada tutulur. Bir kullanıcı kendi dokümanını
    // oluşturabilir ama SADECE ayrıcalıksız bir rolle (student/teacher/
    // parent) — moderatör/admin self-servis atanamaz, sadece mevcut bir
    // admin tarafından (update ile) verilebilir.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['student', 'teacher', 'parent'];
      // Kendi profilini güncelleyen kullanıcı role alanını DEĞİŞTİREMEZ;
      // sadece admin başka birinin rolünü değiştirebilir.
      allow update: if (isOwner(userId) &&
          request.resource.data.role == resource.data.role) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // --- news/{articleId} ---
    // Haberler herkese (giriş yapmamış kullanıcılar dahil) açık okunur —
    // tipik bir haber uygulaması davranışı. Yazma sadece admin/moderatör.
    match /news/{articleId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // --- reels/{reelId} ---
    // Kullanıcıların kendi oyunlarını paylaştığı vitrin. Herkes okuyabilir;
    // sadece giriş yapmış kullanıcılar KENDİ adına (submittedBy == kendi
    // uid'i) yeni bir reel oluşturabilir, başkası adına oluşturamaz.
    // Sahibi kendi gönderisini düzenleyip silebilir; staff (moderatör/
    // admin) moderasyon amacıyla HERHANGİ bir gönderiyi silebilir (ama
    // düzenleyemez — içerik değişikliği sadece sahibine ait).
    match /reels/{reelId} {
      allow read: if true;
      // Storage maliyetini kontrol altında tutmak için kullanıcı başına
      // günde bir yükleme hakkı var — upload_limits/{uid} belgesindeki
      // son yükleme zamanı 24 saatten eskiyse (ya da hiç yoksa) izin
      // verilir. ReelSubmissionRepositoryImpl bu belgeyi aynı batch
      // içinde yazdığı için kontrol her zaman güncel veriye bakar.
      allow create: if isSignedIn() && !isBanned() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.gameUrl is string &&
        request.resource.data.gameUrl.size() > 0 &&
        (!exists(/databases/$(database)/documents/upload_limits/$(request.auth.uid)) ||
         request.time > get(/databases/$(database)/documents/upload_limits/$(request.auth.uid)).data.lastUploadAt + duration.value(24, 'h'));
      allow update: if isSignedIn() && !isBanned() &&
        resource.data.submittedBy == request.auth.uid;
      // Sahibi kendi gönderisini, staff HERHANGİ bir gönderiyi, ve süresi
      // dolmuş (expiresAt geçmiş) bir gönderiyi HERKES (giriş yapmış
      // herhangi bir kullanıcı) silebilir — gerçek sunucu tarafı otomatik
      // silme Cloud Functions (ve Blaze planı) gerektirdiğinden, süresi
      // dolan içerik ona rastlayan HERHANGİ bir istemci tarafından
      // (bkz. reels_providers.dart) temizleniyor.
      allow delete: if isStaff() ||
        (isSignedIn() && resource.data.submittedBy == request.auth.uid) ||
        (isSignedIn() && resource.data.expiresAt is timestamp &&
         resource.data.expiresAt < request.time);
    }

    // --- upload_limits/{userId} ---
    // reels'in create kuralının günlük yükleme kotasını kontrol
    // edebilmesi için her kullanıcının son yükleme zamanını tutar.
    // Sadece sahibi kendi belgesini okuyup yazabilir; `lastUploadAt`
    // sahteciliğini önlemek için sunucu saatine (request.time) eşit
    // olmak zorunda (repository FieldValue.serverTimestamp() kullanıyor).
    match /upload_limits/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId &&
        !isBanned() && request.resource.data.lastUploadAt == request.time;
    }

    // --- support_chats/{chatId} ---
    // Sahibi veya destek ekibi (moderatör/admin) okuyup yazabilir.
    match /support_chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && !isBanned() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        ((resource.data.userId == request.auth.uid && !isBanned()) || isStaff());
      allow delete: if isStaff();

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid ||
           isStaff());
        allow create: if isSignedIn() && !isBanned() &&
          request.resource.data.senderId == request.auth.uid &&
          (get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid ||
           isStaff());
        allow update, delete: if false;
      }
    }

    // --- reports/{reportId} ---
    // Kullanıcıların reels gönderilerini şikayet ettiği kuyruk. Sadece
    // staff okuyabilir (şikayet edenin kimliğini sıradan kullanıcılardan
    // gizler); herhangi bir giriş yapmış (ve banlanmamış) kullanıcı KENDİ
    // adına yeni bir şikayet oluşturabilir. İncelendi/kapatıldı işareti
    // (update) ve silme sadece staff'a açık.
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if isSignedIn() && !isBanned() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reelId is string &&
        request.resource.data.reelId.size() > 0 &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0;
      allow update, delete: if isStaff();
    }

    // Yukarıda tanımlanmayan her şey: varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
